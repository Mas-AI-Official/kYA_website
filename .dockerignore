# Keep the build context tiny and consistent — anything not needed
# inside the container should not enter it.

# VCS + editor
.git
.gitignore
.github
.vscode
.idea
.claude

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js artifacts
.next
out

# Cloudflare / Vercel local artifacts
.vercel
.wrangler

# Env files (NEVER bake secrets into the image)
.env
.env.local
.env.development.local
.env.production.local
.env.example

# Docs (internal-only)
docs

# Source-of-truth assets at root (logo lives at public/kya-logo.png)
KYA-LOGO.png

# Misc
*.log
.DS_Store
README.md
LICENSE
