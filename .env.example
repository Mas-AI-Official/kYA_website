# KYA Mission Control website — environment variables
# Copy to `.env.local` for local dev, or set in Vercel Project Settings → Environment Variables.
# All variables are OPTIONAL — the waitlist form works without any of them
# (submissions are logged to stdout / Vercel Logs).

# --- Resend (transactional email) ---
# Get a key: https://resend.com (3,000 emails/month free)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# WAITLIST_NOTIFY_TO=hello@mas-ai.co
# WAITLIST_FROM=KYA Waitlist <noreply@mas-ai.co>   # must be a verified domain in Resend

# --- Slack (optional, instant notification in a channel) ---
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxxxxxxxxx

# --- Generic webhook (Zapier / n8n / Notion API / your own backend) ---
# Receives the raw JSON payload as POST.
# WAITLIST_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxx/yyyyy/
