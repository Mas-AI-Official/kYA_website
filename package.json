{
  "name": "kya-mission-control-website",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page for KYA Mission Control by MAS-AI",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "npx @cloudflare/next-on-pages@latest",
    "cf:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "cf:deploy": "npm run cf:build && npx wrangler pages deploy .vercel/output/static --project-name=kya-mission-control --commit-dirty=true",
    "gcp:deploy": "bash deploy.sh",
    "gcp:deploy:remote": "gcloud builds submit --config=cloudbuild.yaml --substitutions=SHORT_SHA=$(git rev-parse --short HEAD)"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "16.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
